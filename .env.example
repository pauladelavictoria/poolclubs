# Public by design — RLS is the security boundary, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push (optional in dev — the feature switches itself off without these).
# Generate a pair with `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=
# NOT VITE_-prefixed on purpose: Vite inlines every VITE_* into the client
# bundle, and this is the signing key. Server code reads it from process.env.
VAPID_PRIVATE_KEY=

# Transactional email (optional — the feature switches itself off without it,
# exactly like web push above). Two mails are sent from here, both about
# joining a club: telling an admin somebody has asked to join, and telling
# that somebody the admin approved them. The Supabase auth mails are a
# separate thing, sent by Supabase over SMTP configured in its dashboard.
# NOT VITE_-prefixed: it is a secret, and Vite inlines every VITE_* into the
# client bundle. The From domain must be verified in Resend — see MAIL_FROM in
# src/libs/algorithms/mailText.ts.
RESEND_API_KEY=

# Cookieless audience measurement (optional — no token, no beacon tag, which is
# what dev and CI want). Site token from the Cloudflare dashboard →
# Web Analytics → Add a site. VITE_-prefixed on purpose: the browser needs it,
# and it only names the site a hit belongs to.
VITE_CF_BEACON_TOKEN=

# YouTube live streaming (docs/youtube-streaming.md). NOT VITE_-prefixed: these
# are secrets read only by server routes and the reconciler, never the client
# bundle. Client id/secret from a Google Cloud project with the YouTube Data
# API v3 enabled; TOKEN_ENCRYPTION_KEY is a random 32-byte key (e.g.
# `openssl rand -hex 32`) used to AES-256-GCM refresh tokens and stream keys
# at rest, since club_youtube/club_streams deny all anon/authenticated access
# and are readable only via the service role.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
