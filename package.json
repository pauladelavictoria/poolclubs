{
  "name": "poolclubs-ranking",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:sql": "supabase db query --linked -f",
    "db:dump": "supabase db dump --linked -f sql/schema.sql",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.types.gen.ts",
    "start": "node .output/server/index.mjs",
    "check": "for f in src/libs/*.check.ts src/i18n/*.check.ts; do node \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.170.28",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.45",
    "maplibre-gl": "^6.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-map-gl": "^8.1.2",
    "react-toastify": "^11.0.5",
    "recharts": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@rolldown/binding-darwin-arm64": "^1.2.3",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.2.1"
  },
  "_comment": "optionalDependencies pin the linux x64 native binaries so the build works on CI/deploy hosts; they stay MISSING locally on macOS. Vite 8 bundles with rolldown, so esbuild/rollup/swc are no longer in the tree.",
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.3",
    "@rolldown/binding-linux-x64-musl": "^1.2.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.18",
    "@tailwindcss/oxide-linux-x64-musl": "^4.1.18",
    "lightningcss-linux-x64-gnu": "^1.30.2",
    "lightningcss-linux-x64-musl": "^1.30.2"
  }
}
